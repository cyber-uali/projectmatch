/**
 * ProjectMatch — генератор опроса для Google Forms.
 *
 * Как запустить (2 минуты):
 *   1. Открой https://script.google.com → «Новый проект».
 *   2. Удали код-заглушку и вставь этот файл целиком.
 *   3. Нажми «Выполнить» (▷). Google попросит разрешения — разреши.
 *   4. Открой «Журнал выполнения»: там будут три ссылки —
 *      редактирование формы, ссылка для учеников и таблица с ответами.
 *
 * Повторный запуск создаст ВТОРУЮ форму. Если нужно поправить текст —
 * правь форму в интерфейсе Google Forms, скрипт заново не запускай.
 */
function createProjectMatchSurvey() {
  var form = FormApp.create('Проекты, команда и ИИ — короткий опрос');

  form.setDescription(
    'Привет! Мы делаем ProjectMatch — сервис, который помогает школьникам находить команду ' +
    'для своих проектов и доводить идеи до результата.\n\n' +
    'Опрос анонимный: почту мы не собираем, ответы смотрим только в обобщённом виде. ' +
    'Займёт 3–5 минут.\n\n' +
    'Правильных ответов нет — отвечай честно, для нас это важнее.'
  );

  form.setProgressBar(true);
  form.setCollectEmail(false);               // анонимность
  form.setLimitOneResponsePerUser(false);    // не требуем входа в Google-аккаунт
  form.setAllowResponseEdits(false);         // чтобы нельзя было переписать ответы задним числом
  form.setConfirmationMessage(
    'Спасибо! Ты помогаешь сделать сервис, которым действительно захочется пользоваться.\n\n' +
    'Посмотреть прототип: https://cyber-uali.github.io/projectmatch/'
  );

  // ---------------------------------------------------------------- Раздел 1
  form.addPageBreakItem()
    .setTitle('Пара вопросов о тебе')
    .setHelpText('Здесь и дальше — без имён и контактов, если сам(а) не захочешь иначе.');

  form.addMultipleChoiceItem()
    .setTitle('В каком классе ты учишься?')
    .setChoiceValues(['8 класс', '9 класс', '10 класс', '11 класс', 'Колледж или 1–2 курс вуза'])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Сколько своих проектов (не домашних заданий) ты довёл(ла) до результата?')
    .setChoiceValues([
      'Ни одного, но идеи были',
      'Ни одного, и идей пока не было',
      'Один',
      'Два',
      'Три и больше'
    ])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Сколько времени в неделю ты готов(а) уделять своему проекту?')
    .setChoiceValues([
      'Меньше 2 часов',
      '2–4 часа',
      '5–7 часов',
      'Больше 7 часов',
      'Пока не готов(а) тратить время'
    ])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Приходилось ли тебе делать проекты в команде?')
    .setChoiceValues([
      'Да, и всё получилось',
      'Да, но команда развалилась',
      'Нет, делал(а) один(а)',
      'Нет, но хочу попробовать'
    ])
    .setRequired(true);

  // ---------------------------------------------------------------- Раздел 2
  form.addPageBreakItem()
    .setTitle('Что мешает довести идею до проекта');

  form.addCheckboxItem()
    .setTitle('Что чаще всего мешает тебе начать или закончить свой проект?')
    .setHelpText('Можно выбрать несколько вариантов.')
    .setChoiceValues([
      'Не с кем делать — нет команды',
      'Не хватает навыков',
      'Не знаю, с чего начать',
      'Не хватает времени из-за учёбы',
      'Боюсь, что не получится',
      'Не хватает поддержки взрослых',
      'Не вижу смысла — это никому не нужно'
    ])
    .showOtherOption(true)
    .setRequired(true);

  form.addScaleItem()
    .setTitle('«Мне трудно найти людей, которым интересно то же, что и мне»')
    .setBounds(1, 5)
    .setLabels('Совсем не согласен(на)', 'Полностью согласен(на)')
    .setRequired(true);

  form.addScaleItem()
    .setTitle('«Я бы начал(а) свой проект, если бы рядом была команда»')
    .setBounds(1, 5)
    .setLabels('Совсем не согласен(на)', 'Полностью согласен(на)')
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Бывало, что ты бросал(а) идею, потому что не нашёл(ла) команду?')
    .setChoiceValues([
      'Да, не раз',
      'Да, один раз',
      'Нет',
      'Не было такой ситуации'
    ])
    .setRequired(true);

  // ---------------------------------------------------------------- Раздел 3
  form.addPageBreakItem()
    .setTitle('Навыки и интересы');

  form.addCheckboxItem()
    .setTitle('Что ты умеешь делать лучше всего?')
    .setHelpText('Выбери не больше трёх вариантов.')
    .setChoiceValues([
      'Программирование',
      'Дизайн и графика',
      'Съёмка и монтаж',
      'Тексты и копирайтинг',
      'Анализ данных',
      'Робототехника и 3D',
      'Организация и менеджмент',
      'Публичные выступления',
      'Пока ничего уверенно'
    ])
    .setValidation(FormApp.createCheckboxValidation().setMaximumCheckedItems(3))
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('Какие темы тебе интересны?')
    .setHelpText('Можно выбрать несколько.')
    .setChoiceValues([
      'Технологии и ИИ',
      'Экология',
      'Образование',
      'Медиа и контент',
      'Игры',
      'Спорт',
      'Город и урбанистика',
      'Медицина и биология',
      'Финансы и предпринимательство',
      'Социальные проекты'
    ])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('Где ты обычно ищешь людей в команду?')
    .setHelpText('Можно выбрать несколько.')
    .setChoiceValues([
      'В своём классе и школе',
      'В кружках и секциях',
      'В соцсетях и чатах',
      'На олимпиадах и хакатонах',
      'Не ищу'
    ])
    .showOtherOption(true)
    .setRequired(true);

  // ---------------------------------------------------------------- Раздел 4
  form.addPageBreakItem()
    .setTitle('Команда и ИИ');

  form.addCheckboxItem()
    .setTitle('Людей каких ролей тебе чаще всего не хватает?')
    .setHelpText('Можно выбрать несколько.')
    .setChoiceValues([
      'Разработчик',
      'Дизайнер',
      'Исследователь, который разбирается в теме',
      'Организатор',
      'Тот, кто умеет презентовать',
      'Маркетолог и соцсети',
      'Не знаю'
    ])
    .setRequired(true);

  form.addGridItem()
    .setTitle('Что для тебя важно при выборе тиммейта?')
    .setHelpText('1 — совсем не важно, 5 — очень важно.')
    .setRows([
      'Надёжность и ответственность',
      'Совпадение интересов',
      'Навыки и опыт',
      'Удобный формат общения',
      'Общая цель проекта'
    ])
    .setColumns(['1', '2', '3', '4', '5'])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Как ты относишься к тому, что команду подбирает алгоритм?')
    .setChoiceValues([
      'С интересом — попробовал(а) бы',
      'Нейтрально',
      'Сомневаюсь, что сработает',
      'Против — хочу выбирать сам(а)'
    ])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('Что насторожило бы тебя в таком сервисе?')
    .setHelpText('Можно выбрать несколько.')
    .setChoiceValues([
      'Публикация личных данных',
      'Незнакомые люди в команде',
      'Недоверие к алгоритму',
      'Не хочу показывать свои навыки',
      'Ничего не настораживает'
    ])
    .showOtherOption(true)
    .setRequired(false);

  // ------------------------------------------------------- Раздел 5 (контакты)
  form.addPageBreakItem()
    .setTitle('Хочешь попасть в пилот?')
    .setHelpText(
      'Этот раздел можно пропустить. Он не анонимный — если оставишь контакт, ' +
      'мы напишем только по поводу платформы.'
    );

  form.addMultipleChoiceItem()
    .setTitle('Хочешь получить ссылку на платформу одним из первых?')
    .setChoiceValues(['Да', 'Нет', 'Пока не знаю'])
    .setRequired(false);

  form.addTextItem()
    .setTitle('Если да — оставь Telegram или почту')
    .setHelpText('Необязательно. Поле не анонимное.')
    .setRequired(false);

  // Таблица ответов создаётся сразу и привязывается к форме
  var sheet = SpreadsheetApp.create('ProjectMatch — ответы на опрос');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  // ------------------------------------------------------------- Ссылки
  var report = [
    'Форма создана.',
    '',
    'Редактирование (для тебя): ' + form.getEditUrl(),
    'Ссылка для учеников:      ' + form.getPublishedUrl(),
    'Таблица с ответами:       ' + sheet.getUrl(),
    '',
    'Совет: короткую ссылку для чата можно взять у формы — «Отправить» → «Сократить ссылку».'
  ].join('\n');

  Logger.log(report);
  console.log(report);
  return report;
}
