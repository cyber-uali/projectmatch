/* --------------------------------------------------------------- сборка */

/**
 * Собирает одну форму на нужном языке и привязывает к ней таблицу ответов.
 * @param {'ru'|'kk'} lang
 * @return {{form: FormApp.Form, sheet: SpreadsheetApp.Spreadsheet}}
 */
function buildSurveyForm_(lang) {
  var text = SURVEY_LOCALES[lang];

  var form = FormApp.create(text.formTitle);
  form.setDescription(text.formDescription);
  form.setProgressBar(true);
  form.setCollectEmail(false);               // анонимность
  form.setLimitOneResponsePerUser(false);    // не требуем входа в Google-аккаунт
  form.setAllowResponseEdits(false);         // чтобы нельзя было переписать ответы задним числом
  form.setConfirmationMessage(text.confirmation);

  SURVEY.forEach(function (item) {
    var s = item[lang];

    if (item.type === 'page') {
      var page = form.addPageBreakItem().setTitle(s.title);
      if (s.help) page.setHelpText(s.help);
      return;
    }

    if (item.type === 'choice' || item.type === 'checkbox') {
      var choice = item.type === 'choice' ? form.addMultipleChoiceItem() : form.addCheckboxItem();
      choice.setTitle(s.q);
      if (s.help) choice.setHelpText(s.help);
      choice.setChoiceValues(s.options);
      if (item.other) choice.showOtherOption(true);
      choice.setRequired(!!item.required);
      return;
    }

    if (item.type === 'scale') {
      form.addScaleItem()
        .setTitle(s.q)
        .setBounds(1, 5)
        .setLabels(s.low, s.high)
        .setRequired(!!item.required);
      return;
    }

    if (item.type === 'grid') {
      form.addGridItem()
        .setTitle(s.q)
        .setHelpText(s.help)
        .setRows(s.rows)
        .setColumns(['1', '2', '3', '4', '5'])
        .setRequired(!!item.required);
      return;
    }

    if (item.type === 'text') {
      var input = form.addTextItem().setTitle(s.q);
      if (s.help) input.setHelpText(s.help);
      input.setRequired(!!item.required);
    }
  });

  // Таблица ответов создаётся сразу и привязывается к форме
  var sheet = SpreadsheetApp.create(text.sheetTitle);
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  return { form: form, sheet: sheet };
}

